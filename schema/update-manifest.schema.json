{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paranormal Estates Update Manifest",
  "type": "object",
  "required": ["schemaVersion", "gameId", "gameName", "channel", "enabled", "version", "minimumLauncherVersion"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "gameId": { "type": "string", "minLength": 1 },
    "gameName": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "enum": ["stable", "tester"] },
    "enabled": { "type": "boolean" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "publishedAt": { "type": ["string", "null"], "format": "date-time" },
    "minimumLauncherVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "package": {
      "type": ["object", "null"],
      "required": ["url", "sha256", "sizeBytes", "format"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "format": { "type": "string", "const": "zip" }
      },
      "additionalProperties": false
    },
    "releaseNotesUrl": { "type": ["string", "null"], "format": "uri" }
  },
  "additionalProperties": false
}
